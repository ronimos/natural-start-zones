# Activate the in-repo conda env (created from environment.yml).
# Works with direnv, or manually:  source .envrc
_env="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/.conda"
export CONDA_PREFIX="$_env"
export PATH="$_env/bin:$PATH"
export PROJ_DATA="$_env/share/proj"
export GDAL_DATA="$_env/share/gdal"
unset _env
